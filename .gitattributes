# Shell scripts and container files must keep LF endings even on Windows,
# otherwise Linux containers fail with "/bin/sh^M: bad interpreter".
* text=auto
*.sh text eol=lf
Dockerfile text eol=lf
docker/* text eol=lf
deploy/* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.ps1 text eol=crlf
*.woff2 binary
*.woff binary
*.png binary
