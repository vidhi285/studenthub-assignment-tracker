# Production environment for the cloud VM (~/studenthub/.env on the server).
# scripts/server-setup.sh creates this file automatically with random secrets.
# If you create it by hand, generate secrets on the server with:
#     openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 64
# Never commit the real file.

# Image published by GitHub Actions (must be lower-case).
IMAGE_NAME=ghcr.io/your-github-username/studenthub-assignment-tracker
# Managed by deploy.sh (set to the commit SHA being served).
IMAGE_TAG=main

# Public address served by Caddy:
#   your-domain.example.com   -> HTTPS with your own domain (A record -> server IP)
#   203-0-113-10.sslip.io     -> HTTPS without buying a domain (replace with your IP, dashes)
#   :80                       -> plain HTTP on the IP (only for a first smoke test)
SITE_ADDRESS=203-0-113-10.sslip.io

SECRET_KEY=replace-with-64-random-characters
MYSQL_DATABASE=studenthub
MYSQL_USER=studenthub
MYSQL_PASSWORD=replace-with-a-strong-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-strong-random-password

APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
GUNICORN_WORKERS=2
