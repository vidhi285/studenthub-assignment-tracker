# StudentHub local configuration.
# 1. Copy this file:        Copy-Item .env.example .env
# 2. Replace the three "change-me" values below (see README section 10).
# .env is listed in .gitignore and must never be committed.

# development | production | testing
APP_ENV=development

# Long random string used to sign session cookies. Generate one in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# MySQL runs in its own container; the app connects to the Compose service "db".
DB_HOST=db
DB_PORT=3306
MYSQL_DATABASE=studenthub
MYSQL_USER=studenthub
MYSQL_PASSWORD=vidhi
MYSQL_ROOT_PASSWORD=vidhi

# Host port for http://localhost:5000
APP_PORT=5000

# Time zone for due dates, study sessions and "today".
APP_TIMEZONE=Asia/Kolkata
LOG_LEVEL=INFO
GUNICORN_WORKERS=2

# Only used on the production server (see deploy/.env.production.example):
# IMAGE_NAME=ghcr.io/your-github-username/studenthub-assignment-tracker
